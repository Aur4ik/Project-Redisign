# SQLite is the default. Data and the generated signing key stay in data/.
ADDRESS=127.0.0.1:8081
DATA_DIR=data
# Optional PostgreSQL connection instead of SQLite:
# DATABASE_URL=postgres://alaauto:CHANGE_ME@localhost:5433/alaauto?sslmode=disable
# Set a random secret of at least 32 bytes when deploying:
# JWT_SECRET=
# Enable only behind HTTPS:
COOKIE_SECURE=false
